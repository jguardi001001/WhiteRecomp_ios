// The Vulkan backend of `ren`.
//
// How a frame goes (frame.odin): the draw list's vertices and indices are copied into this frame's host-visible buffers;
// dynamic rendering (Vulkan 1.3, no render pass objects) draws into the swapchain image, with one scissor + pipeline +
// descriptor set + indexed draw per ren.Command, and into render-target textures where the commands say so; the frame is
// submitted and presented. Two frames are in flight. The presentation mode is the first of `present_mode_order` that the
// window system offers: MAILBOX, else FIFO (vsync). Colours are written as given (UNORM swapchain formats, no sRGB).
//
// Files: state.odin (everything the backend owns), memory.odin (buffers, deferred destruction, barriers), swapchain.odin,
// pipeline.odin (+ shaders.odin, generated by shaders/build_shaders.py), texture.odin (textures, uploads, read-back),
// frame.odin (a frame), and this file (loading Vulkan, choosing a device, creating and destroying the backend).
//
// The package is named ren_vulkan because a package called `vulkan` would collide with vendor:vulkan.
package ren_vulkan

import "core:dynlib"
import "core:fmt"
import "core:strings"
import vk "vendor:vulkan"
import ren ".."

// What this backend is to `ren.create_first`.
factory :: proc() -> ren.Factory {
	return ren.Factory{kind = .Vulkan, probe = probe, create = create, fresh_window = false}
}

// ---- the loader -----------------------------------------------------------------------------------------------

@(private)
Loader_State :: enum {
	Untried,
	Loaded,
	Missing,
}

@(private)
loader_state: Loader_State

@(private)
loader_library: dynlib.Library

// Loads the Vulkan loader at run time. It is never linked, so a computer without Vulkan can still start the program and
// fall back to another backend.
load_loader :: proc() -> bool {
	switch loader_state {
	case .Loaded:
		return true
	case .Missing:
		return false
	case .Untried:
	}
	lib: dynlib.Library
	ok: bool
	when ODIN_OS == .Darwin {
		lib, ok = open_loader() // (several places to look: ren_vulkan_darwin.odin)
	} else {
		lib, ok = dynlib.load_library(LOADER_NAME)
	}
	if !ok {
		loader_state = .Missing
		return false
	}
	address, found := dynlib.symbol_address(lib, "vkGetInstanceProcAddr")
	if !found {
		_ = dynlib.unload_library(lib)
		loader_state = .Missing
		return false
	}
	loader_library = lib
	vk.load_proc_addresses_global(address)
	loader_state = .Loaded
	return true
}

// ---- finding a device ---------------------------------------------------------------------------------------

@(private)
Candidate :: struct {
	physical:     vk.PhysicalDevice,
	queue_family: u32, // graphics + present
	name:         string, // temp allocator
	api_version:  u32,
	discrete:     bool,
}

@(private)
create_instance :: proc() -> (instance: vk.Instance, reason: string) {
	version: u32
	if vk.EnumerateInstanceVersion == nil || vk.EnumerateInstanceVersion(&version) != .SUCCESS {
		return nil, "the Vulkan loader is older than 1.1"
	}
	// (1.2 is enough: a 1.2 device with VK_KHR_dynamic_rendering and VK_KHR_synchronization2 does, as MoltenVK before
	// its 1.3 releases and older Mesa drivers have. The instance still asks for 1.3: a 1.1+ loader takes a newer apiVersion)
	if version < vk.API_VERSION_1_2 {
		return nil, fmt.tprintf("the Vulkan loader is %d.%d, 1.2 is needed", vk.API_VERSION_MAJOR(version), vk.API_VERSION_MINOR(version))
	}
	app := vk.ApplicationInfo {
		sType              = .APPLICATION_INFO,
		pApplicationName   = "iv_system",
		applicationVersion = 1,
		pEngineName        = "iv_system",
		engineVersion      = 1,
		apiVersion         = vk.API_VERSION_1_3,
	}
	extensions := make([dynamic]cstring, 0, 4, context.temp_allocator)
	append(&extensions, cstring(vk.KHR_SURFACE_EXTENSION_NAME), SURFACE_EXTENSION)
	flags: vk.InstanceCreateFlags
	when PORTABILITY {
		// a portability implementation (MoltenVK) is only listed to an instance that says it knows what that is
		if instance_has_extension(vk.KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME) {
			append(&extensions, cstring(vk.KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME))
			flags += {.ENUMERATE_PORTABILITY_KHR}
		}
	}
	info := vk.InstanceCreateInfo {
		sType                   = .INSTANCE_CREATE_INFO,
		flags                   = flags,
		pApplicationInfo        = &app,
		enabledExtensionCount   = u32(len(extensions)),
		ppEnabledExtensionNames = raw_data(extensions),
	}
	if res := vk.CreateInstance(&info, nil, &instance); res != .SUCCESS {
		return nil, fmt.tprintf("vkCreateInstance failed: %v", res)
	}
	vk.load_proc_addresses_instance(instance)
	return instance, ""
}

// Vulkan on a system without a native driver is a portability implementation (MoltenVK on macOS): the instance asks for it
// with VK_KHR_portability_enumeration. Elsewhere nothing changes.
PORTABILITY :: ODIN_OS == .Darwin

// Does the device offer this extension?
@(private)
physical_has_extension :: proc(physical: vk.PhysicalDevice, name: string) -> bool {
	count: u32
	vk.EnumerateDeviceExtensionProperties(physical, nil, &count, nil)
	props := make([]vk.ExtensionProperties, count, context.temp_allocator)
	vk.EnumerateDeviceExtensionProperties(physical, nil, &count, raw_data(props))
	for &p in props[:count] {
		if string(cstring(&p.extensionName[0])) == name {
			return true
		}
	}
	return false
}

// Does the loader (or the implementation, when there is no loader) offer this instance extension?
@(private)
instance_has_extension :: proc(name: string) -> bool {
	count: u32
	if vk.EnumerateInstanceExtensionProperties == nil || vk.EnumerateInstanceExtensionProperties(nil, &count, nil) != .SUCCESS {
		return false
	}
	props := make([]vk.ExtensionProperties, count, context.temp_allocator)
	vk.EnumerateInstanceExtensionProperties(nil, &count, raw_data(props))
	for &p in props[:count] {
		if string(cstring(&p.extensionName[0])) == name {
			return true
		}
	}
	return false
}

// The best device that can do what the backend needs: Vulkan 1.3 with dynamic rendering, a queue that draws and presents
// to this window system (to `surface` if given; else as far as it can be known without one), and VK_KHR_swapchain. A
// discrete GPU is preferred over an integrated one.
@(private)
find_device :: proc(instance: vk.Instance, surface: vk.SurfaceKHR = 0) -> (best: Candidate, reason: string, ok: bool) {
	count: u32
	vk.EnumeratePhysicalDevices(instance, &count, nil)
	if count == 0 {
		return {}, "no Vulkan device", false
	}
	devices := make([]vk.PhysicalDevice, count, context.temp_allocator)
	vk.EnumeratePhysicalDevices(instance, &count, raw_data(devices))

	reason = "no suitable device"
	for physical in devices[:count] {
		props: vk.PhysicalDeviceProperties
		vk.GetPhysicalDeviceProperties(physical, &props)
		name := strings.clone(string(cstring(&props.deviceName[0])), context.temp_allocator)

		if props.apiVersion < vk.API_VERSION_1_2 {
			reason = fmt.tprintf("%s: Vulkan %d.%d, 1.2 is needed", name, vk.API_VERSION_MAJOR(props.apiVersion), vk.API_VERSION_MINOR(props.apiVersion))
			continue
		}

		dyn_ok, sync2_ok: bool
		if props.apiVersion >= vk.API_VERSION_1_3 {
			f13 := vk.PhysicalDeviceVulkan13Features {
				sType = .PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
			}
			f2 := vk.PhysicalDeviceFeatures2 {
				sType = .PHYSICAL_DEVICE_FEATURES_2,
				pNext = &f13,
			}
			vk.GetPhysicalDeviceFeatures2(physical, &f2)
			dyn_ok, sync2_ok = bool(f13.dynamicRendering), bool(f13.synchronization2)
		} else if physical_has_extension(physical, vk.KHR_DYNAMIC_RENDERING_EXTENSION_NAME) &&
		   physical_has_extension(physical, vk.KHR_SYNCHRONIZATION_2_EXTENSION_NAME) {
			// Vulkan 1.2: the same two as extensions (backend.odin enables them and calls their KHR entry points)
			dr := vk.PhysicalDeviceDynamicRenderingFeatures {
				sType = .PHYSICAL_DEVICE_DYNAMIC_RENDERING_FEATURES,
			}
			s2 := vk.PhysicalDeviceSynchronization2Features {
				sType = .PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES,
				pNext = &dr,
			}
			f2 := vk.PhysicalDeviceFeatures2 {
				sType = .PHYSICAL_DEVICE_FEATURES_2,
				pNext = &s2,
			}
			vk.GetPhysicalDeviceFeatures2(physical, &f2)
			dyn_ok, sync2_ok = bool(dr.dynamicRendering), bool(s2.synchronization2)
		}
		if !dyn_ok || !sync2_ok {
			reason = fmt.tprintf("%s: Vulkan %d.%d without dynamic rendering / synchronization2", name, vk.API_VERSION_MAJOR(props.apiVersion), vk.API_VERSION_MINOR(props.apiVersion))
			continue
		}

		ext_count: u32
		vk.EnumerateDeviceExtensionProperties(physical, nil, &ext_count, nil)
		extensions := make([]vk.ExtensionProperties, ext_count, context.temp_allocator)
		vk.EnumerateDeviceExtensionProperties(physical, nil, &ext_count, raw_data(extensions))
		has_swapchain := false
		for &e in extensions[:ext_count] {
			if string(cstring(&e.extensionName[0])) == vk.KHR_SWAPCHAIN_EXTENSION_NAME {
				has_swapchain = true
				break
			}
		}
		if !has_swapchain {
			reason = fmt.tprintf("%s: no VK_KHR_swapchain", name)
			continue
		}

		family_count: u32
		vk.GetPhysicalDeviceQueueFamilyProperties(physical, &family_count, nil)
		families := make([]vk.QueueFamilyProperties, family_count, context.temp_allocator)
		vk.GetPhysicalDeviceQueueFamilyProperties(physical, &family_count, raw_data(families))
		family := -1
		for f, i in families[:family_count] {
			if .GRAPHICS not_in f.queueFlags {
				continue
			}
			can_present := false
			if surface != 0 {
				supported: b32
				vk.GetPhysicalDeviceSurfaceSupportKHR(physical, u32(i), surface, &supported)
				can_present = bool(supported)
			} else {
				can_present = presentation_supported(physical, u32(i))
			}
			if can_present {
				family = i
				break
			}
		}
		if family < 0 {
			reason = fmt.tprintf("%s: no queue that draws and presents", name)
			continue
		}

		c := Candidate {
			physical     = physical,
			queue_family = u32(family),
			name         = name,
			api_version  = props.apiVersion,
			discrete     = props.deviceType == .DISCRETE_GPU,
		}
		if !ok || (c.discrete && !best.discrete) {
			best, ok = c, true
		}
	}
	return
}

// ---- the factory's two procedures ---------------------------------------------------------------------------

// Can this computer run the backend? Needs no window: it loads the loader, makes an instance, looks at the devices and
// throws the instance away.
probe :: proc() -> ren.Probe {
	if !load_loader() {
		return {reason = LOADER_NAME + " not found: no Vulkan driver is installed"}
	}
	instance, why := create_instance()
	if instance == nil {
		return {reason = why}
	}
	defer vk.DestroyInstance(instance, nil)

	device, reason, ok := find_device(instance)
	if !ok {
		return {reason = reason}
	}
	return {
		available = true,
		reason = fmt.tprintf(
			"Vulkan %d.%d on %s",
			vk.API_VERSION_MAJOR(device.api_version),
			vk.API_VERSION_MINOR(device.api_version),
			device.name,
		),
		device = device.name,
	}
}

